# 집(홈) PC 전용 로컬 오버라이드 예시
# 사용법: 이 파일을 payment-hom.local.yml 로 복사한 뒤 값을 수정한다
# payment-hom.local.yml 은 Git 추적에서 제외한다
# Docker 없이 localhost 로 Config / Eureka / MySQL 에 연결할 때 사용한다

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/payment?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
